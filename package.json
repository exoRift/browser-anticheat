{
  "name": "thor-anticheat",
  "module": "src/server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch .",
    "build": "vite build && bun build src/server/index.ts --production --compile --outfile thor -e term.js -e pty.js",
    "lint": "eslint .",
    "validate": "tsc --noEmit",
    "update-icons": "curl -L https://github.com/google/material-design-icons/raw/master/variablefont/MaterialSymbolsOutlined%5BFILL,GRAD,opsz,wght%5D.woff2 -o public/fonts/material-symbols-outlined.woff2"
  },
  "dependencies": {
    "blessed": "^0.1.81",
    "captcha-canvas": "^3.2.3",
    "clipboardy": "^4.0.0",
    "cookie-session": "^2.1.0",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "localtunnel": "^2.0.2",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/blessed": "^0.1.25",
    "@types/bun": "latest",
    "@types/cookie-session": "^2.0.49",
    "@types/dom-view-transitions": "^1.0.6",
    "@types/express-ws": "^3.0.5",
    "@types/localtunnel": "^2.0.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "daisyui": "^5.0.0",
    "devtools-detector": "^2.0.22",
    "eslint": "^9.19.0",
    "eslint-config": "github:exoRift/eslint-config",
    "eslint-config-jsdoc": "^15.4.0",
    "react": "^19.0.0",
    "react-daisyui": "^5.0.5",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.8.2",
    "vite": "^6.0.11"
  },
  "trustedDependencies": [
    "skia-canvas"
  ],
  "patchedDependencies": {
    "blessed@0.1.81": "patches/blessed@0.1.81.patch"
